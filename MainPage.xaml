<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="S8_P4.MainPage">
    <StackLayout Padding="20" Spacing="12">
        <Label Text="Suma de Dos Números"
               FontSize="24"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
        <Entry x:Name="txtNumero1"
               Placeholder="Número 1"
               Keyboard="Numeric"
               HorizontalOptions="Center"
               WidthRequest="220" />
        <Entry x:Name="txtNumero2"
               Placeholder="Número 2"
               Keyboard="Numeric"
               HorizontalOptions="Center"
               WidthRequest="220" />
        <Button Text="Sumar"
                Clicked="Sumar_Clicked"
                HorizontalOptions="Center" />
        <Button Text="Restar"
                Clicked="Restar_Clicked"
                HorizontalOptions="Center" />
        <Button Text="Multiplicar"
                Clicked="Multiplicar_Clicked"
                HorizontalOptions="Center" />
        <Button Text="Dividir"
                Clicked="Dividir_Clicked"
                HorizontalOptions="Center" />
        <Label x:Name="lblResultado"
               FontSize="18"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
    </StackLayout>
</ContentPage>
